﻿# ============================================================
# SAATHI — Root environment example
# Copy relevant variables to backend/.env for the Node.js server
# NEVER commit .env files with real secrets
# ============================================================

# MongoDB
MONGODB_URI=your_mongodb_atlas_connection_string

# Auth
JWT_SECRET=your_jwt_secret_min_32_chars

# Server
PORT=5001

# Internal API key for blockchain write endpoints (backend only)
BLOCKCHAIN_SERVICE_KEY=your_internal_blockchain_service_key

# Polygon Amoy (backend only — NEVER prefix with VITE_)
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_key
BLOCKCHAIN_PRIVATE_KEY=0xyour_backend_wallet_private_key
SAATHI_CONTRACT_ADDRESS=0xyour_deployed_contract_address

# ============================================================
# Vite / frontend — ONLY non-secret public values allowed here
# ============================================================
# VITE_API_BASE_URL=https://your-backend-host.railway.app
