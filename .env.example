# ============================================================
# SAATHI — Root environment example
# Copy relevant variables to backend/.env for the Node.js server
# NEVER commit .env files with real secrets
# ============================================================

# MongoDB
MONGODB_URI=your_mongodb_atlas_connection_string

# Auth
JWT_SECRET=your_jwt_secret_min_32_chars

# Server
PORT=5001

# Data Gov API (Mandi prices)
DATA_GOV_API_KEY=your_data_gov_api_key

# Fast API / Voice Engine
VITE_FASTAPI_WS_URL=wss://saathi-backend-7t91.onrender.com/ws/voice
VITE_FASTAPI_URL=https://saathi-backend-7t91.onrender.com

# Gemini API Key (Required for AI assistant)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Sarvam AI API Key (Optional for Indian TTS/STT)
SARVAM_API_KEY=your_sarvam_api_key_here
