# Saathi AI Backend Environment Variables
# Copy this file to .env and fill in the values before running the app.

# Gemini API Key (Required)
# Get from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Sarvam AI API Key (Optional but recommended for high-quality Indian TTS/STT)
# Get from https://sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Model Selection
# Recommended: gemini-3.5-flash-lite (fastest, cheapest) or gemini-1.5-flash
MODEL_NAME=gemini-3.5-flash-lite

