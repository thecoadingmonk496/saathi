def _extract_text_from_bhashini_response(data: Dict[str, Any]) -> str:
    if not isinstance(data, dict):
        return ""

    candidates = [
        data.get("output"),
        data.get("pipelineResponse"),
        data.get("result"),
        data.get("data"),
    ]

    for item in candidates:
        if isinstance(item, list):
            for element in item:
                if isinstance(element, dict):
                    for key in ("text", "transcript", "outputText", "value", "result"):
                        if key in element and isinstance(element[key], str):
                            return element[key]
                elif isinstance(element, str):
                    return element
        elif isinstance(item, dict):
            for key in ("text", "transcript", "outputText", "value", "result"):
                if key in item and isinstance(item[key], str):
                    return item[key]
        elif isinstance(item, str):
            return item

    return ""

