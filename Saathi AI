def _bhashini_stt(audio_base64: str) -> str:
    payload = {
        "config": {
            "language": {"sourceLanguage": "hi"},
            "serviceId": "ai4bharat/whisper-hindi",
            "audioFormat": "wav",
            "samplingRate": 16000,
        },
        "inputData": {
            "audio": [{"audioContent": audio_base64}],
        },
    }
    result = _bhashini_call("asr_nmt", payload)
    return _extract_text_from_bhashini_response(result).strip()

