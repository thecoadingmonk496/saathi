import os
import logging
from typing import Any, Dict, List, Optional

import requests
from dotenv import load_dotenv
from langchain.agents import AgentExecutor, create_tool_calling_agent
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.tools import tool
from langchain_google_genai import ChatGoogleGenerativeAI

load_dotenv()

GOOGLE_API_KEY = os.getenv("GOOGLE_API_KEY")
USER_ID = os.getenv("USER_ID")
ULCA_API_KEY = os.getenv("ULCA_API_KEY")
INFERENCE_API_KEY = os.getenv("INFERENCE_API_KEY")
MODEL_NAME = os.getenv("MODEL_NAME", "gemini-1.5-flash")

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

@tool
def get_mandi_price(crop_name: str, state: str) -> str:
    """Return a mock mandi price for a crop in a given Indian state."""
    base_prices = {
        "wheat": 2450,
        "rice": 2680,
        "onion": 1850,
        "potato": 2200,
        "tomato": 3150,
        "cotton": 6200,
        "mustard": 5400,
        "chana": 4700,
    }
    price = base_prices.get(crop_name.lower(), 2500)
    return f"The price is ₹{price} per quintal in {state}."

llm = ChatGoogleGenerativeAI(
    model=MODEL_NAME,
    google_api_key=GOOGLE_API_KEY,
)

prompt = ChatPromptTemplate.from_messages(
    [
        (
            "system",
            (
                "You are Saathi, an agricultural assistant for Indian farmers. "
                "The user is speaking Hindi. You MUST answer entirely in Hindi "
                "using the Devanagari script. Keep answers under 2 sentences."
            ),
        ),
        ("human", "{input}"),
        ("placeholder", "{agent_scratchpad}"),
    ]
)

tools = [get_mandi_price]
agent = create_tool_calling_agent(llm, tools, prompt)
agent_executor = AgentExecutor(agent=agent, tools=tools, verbose=True)

