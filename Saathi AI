def _bhashini_tts(text: str) -> str:
    payload = {
        "config": {
            "language": {"sourceLanguage": "hi", "targetLanguage": "hin_Deva"},
            "serviceId": "ai4bharat/indic-tts",
            "audioFormat": "wav",
        },
        "inputData": {
            "text": [{"text": text}],
        },
    }
    result = _bhashini_call("tts", payload)
    return _extract_audio_from_bhashini_response(result).strip()

