def process_voice_query(audio_base64: str) -> str:
    """
    Takes Base64-encoded audio input, converts speech to text using Bhashini ASR,
    answers the query via LangChain + GenAI, converts the answer back to speech
    using Bhashini TTS, and returns the Base64 audio response.
    """
    recognized_text = _bhashini_stt(audio_base64)

    if not recognized_text:
        recognized_text = "मुझे आपकी आवाज़ समझ नहीं आई। कृपया फिर से बताइए।"

    try:
        # AgentExecutor.run expects a plain input string
        ai_answer = agent_executor.run(recognized_text)
    except Exception as e:
        logger.exception("Agent execution failed")
        ai_answer = ""

    if not ai_answer or not isinstance(ai_answer, str):
        ai_answer = "सारी जानकारी उपलब्ध नहीं है।"

    audio_response = _bhashini_tts(ai_answer)
    if not audio_response:
        raise ValueError("Bhashini TTS did not return audio.")

    return audio_response
