def _bhashini_headers() -> Dict[str, str]:
    return {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "userID": USER_ID or "",
        "ulcaApiKey": ULCA_API_KEY or "",
        "inferenceApiKey": INFERENCE_API_KEY or "",
    }

# ...existing code...

def _bhashini_call(task_type: str, payload: Dict[str, Any]) -> Dict[str, Any]:
    if not USER_ID or not ULCA_API_KEY or not INFERENCE_API_KEY:
        raise ValueError(
            "Missing Bhashini environment variables. Set USER_ID, ULCA_API_KEY, and INFERENCE_API_KEY."
        )

    endpoint = "https://dhruva-api.bhashini.gov.in/services/inference/pipeline"
    request_body = {
        "pipelineTasks": [
            {
                "taskType": task_type,
                "config": payload.get("config", {}),
            }
        ],
        "inputData": payload.get("inputData", {}),
    }

    response = requests.post(
        endpoint,
        headers=_bhashini_headers(),
        json=request_body,
        timeout=120,
    )
    response.raise_for_status()
    return response.json()

